# Copy to .env. Sign-in is off by default and can be enabled under Dashboard login.
# Optional: set these to enable sign-in on first startup.
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=
# Bound to localhost by default. Set to your host IP or 0.0.0.0 for LAN access.
DASHBOARD_BIND_IP=127.0.0.1
DASHBOARD_PORT=8080
# Set to your trusted reverse proxy IP/CIDR when serving over HTTPS behind a proxy.
FORWARDED_ALLOW_IPS=127.0.0.1
